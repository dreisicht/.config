#!/usr/bin/env bash
# Set every RGB device to a single static fire-orange, then exit.
#
# Uses Direct mode because it is the one mode every device here supports
# (DRAM, GPU and the H150i pump have no "Static"). Direct colours live in the
# device until power is cut, so this runs once per login via fire-rgb.service.
#
# Every device gets an explicit -d: an openrgb call without -d targets *all*
# devices and blanks the ones it has no colour for.
#
# Note: openrgb exits 0 even when it rejects arguments, so failures show up as
# text on stderr, not in the exit status. The unit's journal is the place to look.
set -euo pipefail

COLOR="FF3000"   # fire orange; LEDs skew yellow, so keep green low
MODE="Direct"

# udev grants /dev/i2c-* access via uaccess when the seat session goes active,
# which can land after this unit starts; retry until the DRAM shows up.
indices=()
for attempt in {1..15}; do
    listing=$(openrgb --list-devices 2>/dev/null || true)
    mapfile -t indices < <(grep -E '^[0-9]+: ' <<<"$listing" | cut -d: -f1)
    grep -q 'Corsair Vengeance' <<<"$listing" && break
    sleep 2
done

if ((${#indices[@]} == 0)); then
    echo "fire-rgb: no RGB devices detected" >&2
    exit 1
fi

args=()
for i in "${indices[@]}"; do
    args+=(-d "$i" -m "$MODE" -c "$COLOR")
done

echo "fire-rgb: setting ${#indices[@]} device(s) to #${COLOR}: ${indices[*]}"
exec openrgb "${args[@]}"
