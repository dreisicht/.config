#!/usr/bin/env bash
# Set every RGB device to a single static fire-orange, then exit.
#
# Two tools, one owner per device:
#   - liquidctl: ASUS Aura board headers and the H150i pump logo. Faster and
#     simpler than OpenRGB for these; OpenRGB's "ASUS Aura Motherboard" and
#     "Corsair Hydro Series" detectors are disabled (~/.config/OpenRGB/OpenRGB.json)
#     so the two never open the same device.
#   - OpenRGB: the four Corsair Vengeance RAM sticks and the RTX 4090.
#
# OpenRGB uses Direct mode for static colours because it is the one mode both
# the RAM and the GPU support (neither has "Static"); the RAM's default look is
# its "Color Shift" effect (see RAM_MODE below). Colours live in the devices until power is
# cut, so this runs at login and after every resume via ~/.config/startup.sh.
#
# Every OpenRGB device gets an explicit -d: an openrgb call without -d targets
# *all* devices and blanks the ones it has no colour for.
#
# Note: openrgb exits 0 even when it rejects arguments, so failures show up as
# text on stderr, not in the exit status. The unit's journal is the place to look.
set -euo pipefail

COLOR="${1:-FF3000}"   # fire orange by default (LEDs skew yellow, so keep green low);
                       # pass another hex colour as $1, e.g. 000000 = off
MODE="Direct"

# Default look (no argument): the RAM runs its own "Color Shift" effect,
# blending between fire orange and deep red on the sticks' controller (no CPU
# load). With a colour argument everything, the RAM included, goes static in
# that colour, so previews and "off" stay simple.
RAM_MODE="Color Shift"
RAM_COLORS="FF3000,8B0000"
RAM_SPEED=40               # 0-100
if (($# > 0)); then
    RAM_MODE=""
fi

# Board headers and pump logo via liquidctl. A failure here shouldn't keep
# the RAM and GPU from getting their colour, so only warn.
liquidctl --match aura initialize >/dev/null &&
    liquidctl --match aura set sync color static "$COLOR" ||
    echo "fire-rgb: liquidctl failed for the ASUS Aura controller" >&2
liquidctl --match h150i set logo color fixed "$COLOR" ||
    echo "fire-rgb: liquidctl failed for the H150i logo" >&2

# udev grants /dev/i2c-* access via uaccess when the seat session goes active,
# which can land after this unit starts; retry until the DRAM shows up.
indices=()
for attempt in {1..15}; do
    listing=$(openrgb --list-devices 2>/dev/null || true)
    mapfile -t indices < <(grep -E '^[0-9]+: ' <<<"$listing" | cut -d: -f1)
    grep -q 'Corsair Vengeance' <<<"$listing" && break
    sleep 2
done

if ((${#indices[@]} == 0)); then
    echo "fire-rgb: no RGB devices detected" >&2
    exit 1
fi

args=()
for i in "${indices[@]}"; do
    if [[ -n $RAM_MODE ]] && grep -qE "^$i: Corsair Vengeance" <<<"$listing"; then
        args+=(-d "$i" -m "$RAM_MODE" -c "$RAM_COLORS" -s "$RAM_SPEED")
    else
        args+=(-d "$i" -m "$MODE" -c "$COLOR")
    fi
done

echo "fire-rgb: setting ${#indices[@]} device(s) to #${COLOR}${RAM_MODE:+ (RAM: $RAM_MODE $RAM_COLORS)}: ${indices[*]}"
exec openrgb "${args[@]}"
